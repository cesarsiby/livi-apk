# LIVI backend — environment variable template.
#
# V45 finding: no .env.example existed anywhere in the repository before
# this version — anyone setting up a new environment (local dev, staging,
# CI) had to reverse-engineer the required variables directly from
# src/config/env.js. This file documents every variable that schema
# validates, with safe example values. Copy to .env and fill in real
# values; .env itself is gitignored (see .gitignore, added in V41) and
# must never be committed.

# --- Core ---
NODE_ENV=development
PORT=3000

# PostgreSQL connection string. Required, no default.
DATABASE_URL=postgres://livi:livi_dev_only@127.0.0.1:5432/livi_dev

# --- Auth secrets — required, minimum 32 characters each, no defaults.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-real-random-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-real-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ---
# CORS_ORIGIN is a legacy fallback; ALLOWED_ORIGINS (comma-separated) is
# what src/server.js actually checks first. In production, every origin
# listed here MUST be https:// (enforced at startup, see env.js).
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# --- File storage ---
UPLOAD_DIR=./storage

# --- OTP / auth-testing convenience ---
# DEV_OTP is the fixed 6-digit code used instead of a real SMS provider
# when ALLOW_STAGING_TEST_HELPERS resolves to true (always true outside
# production; only true in production if ALLOW_STAGING_TEST_HELPERS=true
# is explicitly set — see below). NEVER a real OTP mechanism.
DEV_OTP=123456

# --- Production-only required secrets ---
# These three, plus HTTPS-only ALLOWED_ORIGINS above, are REQUIRED and
# validated at startup when NODE_ENV=production (the process refuses to
# start without them). Leave blank for local development.
PAYMENT_WEBHOOK_SECRET=
LIVI_PROOF_ENCRYPTION_KEY=
FILE_ACCESS_SECRET=

# --- Rate limiting ---
AUTH_RATE_LIMIT=12

# --- Staging test helpers (V45) ---
# When NODE_ENV=production, the app normally requires a real SMS provider
# (for OTP) and a real payment partner webhook (escrow funding) — the dev
# shortcuts for both are disabled. A staging environment usually needs
# production-grade secret strictness AND HTTPS (do not weaken these for
# staging) but ALSO needs to be testable end-to-end without a live SMS/
# payment integration, which this project does not have wired up yet.
#
# Setting this to "true" re-enables DEV_OTP and the dev payment-confirm
# route (POST /escrow/payment/confirm) even when NODE_ENV=production.
# It logs a loud warning on startup when active. This must NEVER be set
# to "true" on a real production deployment — only on a staging
# deployment that intentionally needs these shortcuts. Defaults to
# "false"; outside production (development/test) these shortcuts are
# always available regardless of this flag.
ALLOW_STAGING_TEST_HELPERS=false
